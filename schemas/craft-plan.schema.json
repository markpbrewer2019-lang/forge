{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forge:craft-plan:v1",
  "title": "Forge branch-complete crafting plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "starting_state", "target", "entry", "nodes"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "starting_state": {"$ref": "#/$defs/item"},
    "target": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "target_rarity": {"type": "string"},
    "base_owned": {"type": "boolean"},
    "base_resource": {"type": "string", "minLength": 1},
    "claimed_total_cost": {"$ref": "#/$defs/number"},
    "keeper_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "initial": {"$ref": "#/$defs/strings"},
        "lock_on_acquire": {"type": "boolean"},
        "max_fallback_rungs": {"type": "integer", "minimum": 0, "maximum": 1},
        "restart_actions": {"$ref": "#/$defs/strings"},
        "allow_initial_loss_on_restart": {"type": "boolean"}
      }
    },
    "acceptable_settles": {"type": "array", "items": {
      "type": "object", "required": ["name", "required_modifiers"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "required_modifiers": {"$ref": "#/$defs/strings"}}
    }},
    "entry": {"type": "string", "minLength": 1},
    "nodes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "number": {"oneOf": [{"type": "integer"}, {"type": "string", "pattern": "^-?[0-9]+([/.][0-9]+)?$"}]},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["base", "ilvl", "rarity"],
      "properties": {
        "base": {"type": "string", "minLength": 1},
        "ilvl": {"type": "integer", "minimum": 1},
        "rarity": {"type": "string", "minLength": 1},
        "quality": {"type": "integer", "minimum": 0},
        "mods": {"$ref": "#/$defs/strings"},
        "fractured": {"$ref": "#/$defs/strings"},
        "protected": {"$ref": "#/$defs/strings"},
        "flags": {"$ref": "#/$defs/strings"}
      }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["objective"],
      "oneOf": [
        {"required": ["action", "branches"], "not": {"required": ["terminal"]}},
        {"required": ["terminal"], "not": {"required": ["action"]}}
      ],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "objective_mods": {"$ref": "#/$defs/strings"},
        "rung": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "branches": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "expected_state": {"$ref": "#/$defs/item"},
        "claimed_probabilities": {"type": "object", "additionalProperties": {"$ref": "#/$defs/number"}},
        "terminal": {"enum": ["success", "failure", "settle"]},
        "settle_reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
